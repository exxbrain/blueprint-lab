// Cloudflare Workers: сайт — статические файлы из dist, перед ними — проверка логина и пароля (worker/index.js)
{
  "name": "blueprint-lab",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Worker раньше файлов на каждый запрос: иначе Cloudflare отдаёт файлы без проверки пароля
    "run_worker_first": true
  },
  "workers_dev": true,
  // отдельные адреса версий выключены: у старых версий без пароля адрес остался бы открытым
  "preview_urls": false
}
